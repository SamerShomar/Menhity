APP_NAME="منحتي"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=menhity
DB_USERNAME=menhity
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# جذر مرفوعات الطلاب. اتركه فارغاً محلياً؛ على منصّة نشر ثبّت قرصاً
# (Volume) واكتب هنا مسار تثبيته، وإلا مُحيت المرفوعات مع كل نشر.
PRIVATE_STORAGE_ROOT=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================
# البريد الإلكتروني — مطلوب لتأكيد الحساب واستعادة كلمة المرور
#
# القيمة log تكتب الرسالة في storage/logs/laravel.log بدل إرسالها،
# وهي كافية للتطوير: الرمز يظهر في السجل.
#
# للإنتاج: أغلب الاستضافات تحجب منافذ SMTP الصادرة (25 و465 و587)،
# فالأضمن ناقل يعمل عبر HTTPS. خياران:
#
# ١) تملك نطاقاً موثَّقاً لدى Resend (3000 رسالة/شهر مجاناً) — متغيّران:
#   MAIL_MAILER=resend
#   RESEND_API_KEY=<مفتاح Resend>
#
# ٢) ترسل من حساب Gmail بلا نطاق (500 رسالة/يوم) عبر Gmail API:
#   MAIL_MAILER=gmail
#   ثم شغّل على جهازك: php artisan menhity:gmail-auth
#   فيطبع GMAIL_CLIENT_ID و GMAIL_CLIENT_SECRET و GMAIL_REFRESH_TOKEN.
#   بريد المُرسِل هو بريد الحساب المُخوَّل نفسه.
#
# أو عبر SMTP حيث لا يكون المنفذ محجوباً:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com     # أو smtp.gmail.com مع كلمة مرور تطبيق
#   MAIL_PORT=587                 # 587 أو 465 فقط — المنفذ 2587 خاص بـ Resend وحده
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<مفتاح Resend>
#   MAIL_SCHEME=smtp        # smtp للمنفذ 587، وsmtps للمنفذ 465 — القيمة tls غير مقبولة
# وبريد المُرسِل يجب أن يكون على نطاق موثَّق لدى المزوّد.
#
# للتشخيص: php artisan menhity:mail-test <بريدك>
# ==============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
# عنوان المُرسِل مقيَّد بنطاق موثَّق لدى المزوّد. أما عنوان الردّ فأي بريد
# يصلح — اضبطه ليصل إليك ردّ من يضغط "ردّ" على الرسالة.
MAIL_REPLY_TO_ADDRESS=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail عبر HTTPS — تُطبع الثلاثة بأمر php artisan menhity:gmail-auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================
# أدوات الذكاء الاصطناعي
# بدون أي مفتاح تعمل الأدوات بوضع المحاكاة، ويبقى المشروع قابلاً
# للتشغيل والعرض فور استنساخه.
#
# يُختار المزوّد تلقائياً حسب المفتاح المضبوط. لفرض مزوّد بعينه
# اضبط AI_PROVIDER على cloudflare أو gemini أو anthropic.
# ==============================================================
AI_PROVIDER=

# Cloudflare Workers AI — حصة يومية مجانية بلا بطاقة دفع (dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Google Gemini — طبقة مجانية بحدود يومية (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude — بالاستهلاك المدفوع (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
