APP_NAME="منحتي"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=menhity
DB_USERNAME=menhity
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================
# البريد الإلكتروني — مطلوب لتأكيد الحساب واستعادة كلمة المرور
#
# القيمة log تكتب الرسالة في storage/logs/laravel.log بدل إرسالها،
# وهي كافية للتطوير: الرمز يظهر في السجل.
#
# للإنتاج استخدم SMTP من مزوّد مجاني، مثل Resend (3000 رسالة/شهر):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=<مفتاح Resend>
#   MAIL_SCHEME=tls
# وبريد المُرسِل يجب أن يكون على نطاق موثَّق لدى المزوّد.
# ==============================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==============================================================
# أدوات الذكاء الاصطناعي
# بدون أي مفتاح تعمل الأدوات بوضع المحاكاة، ويبقى المشروع قابلاً
# للتشغيل والعرض فور استنساخه.
#
# يُختار المزوّد تلقائياً حسب المفتاح المضبوط. لفرض مزوّد بعينه
# اضبط AI_PROVIDER على cloudflare أو gemini أو anthropic.
# ==============================================================
AI_PROVIDER=

# Cloudflare Workers AI — حصة يومية مجانية بلا بطاقة دفع (dash.cloudflare.com)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Google Gemini — طبقة مجانية بحدود يومية (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Anthropic Claude — بالاستهلاك المدفوع (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
