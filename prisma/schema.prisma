// ============================================================
//  منصة منحتي — Prisma Schema
//  قاعدة البيانات: PostgreSQL
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
//  التعدادات (Enums)
// ------------------------------------------------------------

enum UserRole {
  STUDENT   // طالب
  EXPERT    // خبير أكاديمي
  MODERATOR // مشرف
  ADMIN     // مدير النظام
}

enum UserStatus {
  ACTIVE    // نشط
  INACTIVE  // غير نشط
  SUSPENDED // موقوف
}

enum Gender {
  MALE
  FEMALE
}

enum DegreeLevel {
  HIGH_SCHOOL // الثانوية العامة
  DIPLOMA     // دبلوم
  BACHELOR    // بكالوريوس
  MASTER      // ماجستير
  PHD         // دكتوراه
}

enum ExperienceType {
  INTERNSHIP // تدريب
  JOB        // عمل
  RESEARCH   // بحثي
  VOLUNTEER  // تطوعي
}

enum FundingType {
  FULL         // ممولة بالكامل
  PARTIAL      // تمويل جزئي
  TUITION_ONLY // رسوم دراسية فقط
}

enum ScholarshipStatus {
  DRAFT          // مسودة
  PENDING_REVIEW // بانتظار المراجعة والاعتماد
  PUBLISHED      // منشورة ونشطة
  EXPIRED        // منتهية التقديم
  ARCHIVED       // مؤرشفة
}

enum LanguageRequirement {
  REQUIRED     // يتطلب أيلتس / توفل
  NOT_REQUIRED // لا يشترط شهادة لغة
}

enum DocumentKind {
  CV                // سيرة ذاتية
  MOTIVATION_LETTER // خطاب دافع
  TRANSCRIPT        // سجل أكاديمي
  RECOMMENDATION    // خطاب توصية
  PASSPORT          // جواز سفر
  CERTIFICATE       // شهادة
  OTHER             // أخرى
}

enum NotificationType {
  NEW_MATCH          // منحة جديدة تناسبك
  DEADLINE_REMINDER  // تذكير بموعد التقديم
  DOCUMENT_REVIEWED  // اكتمال مراجعة المستندات
  SAVED_UPDATED      // تحديث المحفوظات
  DEADLINE_PASSED    // انتهاء موعد التقديم
  ORDER_UPDATE       // تحديث على طلب الصياغة
  SYSTEM             // إشعار نظام
}

enum CvOrderStatus {
  DRAFT            // مسودة قيد التعبئة
  SUBMITTED        // تم الإرسال
  IN_EXPERT_REVIEW // قيد المراجعة اليدوية بواسطة الخبير
  ATS_CHECK        // الفحص الدقيق لمعايير ATS
  DELIVERED        // تم التسليم
  CANCELLED        // ملغي
}

enum TimelineStatus {
  PENDING     // بانتظار
  IN_PROGRESS // قيد التنفيذ
  DONE        // مكتمل
}

enum AiRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ApplicationStatus {
  PLANNED     // ينوي التقديم
  IN_PROGRESS // قيد التجهيز
  SUBMITTED   // تم التقديم
  ACCEPTED    // مقبول
  REJECTED    // مرفوض
}

// ------------------------------------------------------------
//  المستخدمون والمصادقة
// ------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String?
  fullName     String
  avatarUrl    String?
  phone        String?
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)

  emailVerifiedAt   DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?
  lastLoginAt       DateTime?

  // مزوّد خارجي (Google / Apple)
  oauthProvider String?
  oauthId       String?

  // الإعدادات — اللغة والمنطقة
  locale   String @default("ar")
  timezone String @default("Asia/Riyadh")

  // الإعدادات — الخصوصية والأمان
  profileVisible           Boolean @default(true)
  shareDataWithUniversities Boolean @default(false)

  // الإعدادات — تنبيهات البريد
  notifyNewMatches        Boolean @default(true)
  notifyApplicationStatus Boolean @default(true)
  notifyNews              Boolean @default(false)

  acceptedTermsAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  profile            StudentProfile?
  expertProfile      ExpertProfile?
  sessions           Session[]
  verificationCodes  VerificationCode[]
  savedScholarships  SavedScholarship[]
  matches            ScholarshipMatch[]
  applications       Application[]
  documents          Document[]
  notifications      Notification[]
  cvOrders           CvOrder[]          @relation("OrderOwner")
  assignedCvOrders   CvOrder[]          @relation("OrderExpert")
  cvOrderNotes       CvOrderNote[]
  aiRuns             AiToolRun[]
  auditLogs          AuditLog[]
  createdScholarships Scholarship[]     @relation("ScholarshipAuthor")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

/// جلسة مسجّلة في قاعدة البيانات — تغذّي شاشة "الجلسات والأجهزة النشطة"
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  browser   String?
  os        String?
  deviceType String?
  location  String?

  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

/// رموز التحقق واستعادة كلمة المرور (6 أرقام)
model VerificationCode {
  id        String           @id @default(cuid())
  userId    String
  type      VerificationType
  codeHash  String
  attempts  Int              @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_codes")
}

// ------------------------------------------------------------
//  الملف الأكاديمي للطالب
// ------------------------------------------------------------

model StudentProfile {
  id     String @id @default(cuid())
  userId String @unique

  fullNameAr    String?
  fullNameEn    String?
  birthDate     DateTime?
  nationality   String?
  gender        Gender?
  country       String?
  city          String?
  linkedinUrl   String?
  portfolioUrl  String?
  academicEmail String?
  bio           String?  @db.Text
  headline      String?

  /// نسبة اكتمال الملف (0-100) — تُحتسب تلقائياً
  completionPercent Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  educations     Education[]
  experiences    Experience[]
  skills         ProfileSkill[]
  languages      ProfileLanguage[]
  certifications Certification[]
  projects       Project[]
  interests      Interest[]

  @@map("student_profiles")
}

model Education {
  id        String      @id @default(cuid())
  profileId String
  degree    DegreeLevel
  major     String?
  institution String
  country     String?

  graduationYear Int?
  isCurrent      Boolean @default(false)

  /// المعدل ونظامه — يدعم 4.0 و 5.0 و 100
  gpaValue Float?
  gpaScale Float?
  honors   String?

  thesisTitle String? @db.Text
  sortOrder   Int     @default(0)

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("educations")
}

model Experience {
  id           String         @id @default(cuid())
  profileId    String
  title        String
  type         ExperienceType @default(JOB)
  organization String
  country      String?
  city         String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean        @default(false)
  description  String?        @db.Text
  sortOrder    Int            @default(0)

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("experiences")
}

model ProfileSkill {
  id        String @id @default(cuid())
  profileId String
  name      String

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("profile_skills")
}

model ProfileLanguage {
  id          String  @id @default(cuid())
  profileId   String
  name        String
  proficiency String
  certificate String?

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("profile_languages")
}

model Certification {
  id           String    @id @default(cuid())
  profileId    String
  title        String
  issuer       String?
  credentialId String?
  issueDate    DateTime?
  url          String?

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("certifications")
}

model Project {
  id          String  @id @default(cuid())
  profileId   String
  title       String
  description String? @db.Text
  year        Int?
  url         String?

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("projects")
}

model Interest {
  id        String @id @default(cuid())
  profileId String
  name      String

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, name])
  @@map("interests")
}

// ------------------------------------------------------------
//  المنح
// ------------------------------------------------------------

model Scholarship {
  id       String @id @default(cuid())
  slug     String @unique
  titleAr  String
  titleEn  String?

  /// الجهة المانحة
  provider    String
  universityName String?

  countryCode String
  countryNameAr String
  region      String?

  fundingType         FundingType
  languageRequirement LanguageRequirement @default(NOT_REQUIRED)
  status              ScholarshipStatus   @default(DRAFT)

  description String? @db.Text
  applyUrl    String?
  coverImageUrl String?
  logoUrl       String?

  openDate DateTime?
  deadline DateTime?

  minGpa   Float?
  gpaScale Float?
  /// معدل قبول الطلبات (نسبة مئوية) — يظهر في صفحة التفاصيل
  acceptanceRate Float?

  isFeatured  Boolean @default(false)
  viewsCount  Int     @default(0)

  createdById String?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy     User?                    @relation("ScholarshipAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  levels        ScholarshipLevel[]
  majors        ScholarshipMajor[]
  eligibility   ScholarshipEligibility[]
  documents     ScholarshipDocument[]
  benefits      ScholarshipBenefit[]
  savedBy       SavedScholarship[]
  matches       ScholarshipMatch[]
  applications  Application[]
  notifications Notification[]

  @@index([status, deadline])
  @@index([countryCode])
  @@index([fundingType])
  @@index([isFeatured])
  @@map("scholarships")
}

model ScholarshipLevel {
  id            String      @id @default(cuid())
  scholarshipId String
  level         DegreeLevel

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, level])
  @@index([level])
  @@map("scholarship_levels")
}

model ScholarshipMajor {
  id            String @id @default(cuid())
  scholarshipId String
  name          String
  icon          String?

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@index([name])
  @@map("scholarship_majors")
}

/// شروط الأهلية — قائمة نقاط
model ScholarshipEligibility {
  id            String @id @default(cuid())
  scholarshipId String
  text          String @db.Text
  sortOrder     Int    @default(0)

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@map("scholarship_eligibility")
}

/// المستندات المطلوبة — الاسم + ملاحظة (PDF، مترجمة ومعتمدة، 1000 كلمة...)
model ScholarshipDocument {
  id            String @id @default(cuid())
  scholarshipId String
  name          String
  note          String?
  sortOrder     Int    @default(0)

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@map("scholarship_documents")
}

/// المزايا والتمويل — تغطية كاملة، تذاكر السفر، راتب شهري...
model ScholarshipBenefit {
  id            String @id @default(cuid())
  scholarshipId String
  title         String
  description   String?
  icon          String?
  sortOrder     Int    @default(0)

  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@index([scholarshipId])
  @@map("scholarship_benefits")
}

// ------------------------------------------------------------
//  العلاقة بين المستخدم والمنح
// ------------------------------------------------------------

model SavedScholarship {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId])
  @@map("saved_scholarships")
}

/// نتيجة المطابقة المحسوبة + أسبابها ("لماذا تناسبني؟")
model ScholarshipMatch {
  id            String   @id @default(cuid())
  userId        String
  scholarshipId String
  score         Int
  reasons       String[]
  computedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([userId, score])
  @@map("scholarship_matches")
}

model Application {
  id            String            @id @default(cuid())
  userId        String
  scholarshipId String
  status        ApplicationStatus @default(PLANNED)
  notes         String?           @db.Text
  submittedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([userId, scholarshipId])
  @@index([status])
  @@map("applications")
}

// ------------------------------------------------------------
//  المستندات المرفقة
// ------------------------------------------------------------

model Document {
  id           String       @id @default(cuid())
  userId       String
  kind         DocumentKind @default(OTHER)
  originalName String
  storedName   String
  mimeType     String
  sizeBytes    Int
  url          String
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("documents")
}

// ------------------------------------------------------------
//  الإشعارات
// ------------------------------------------------------------

model Notification {
  id            String           @id @default(cuid())
  userId        String
  type          NotificationType
  title         String
  body          String?          @db.Text
  badgeLabel    String?
  actionLabel   String?
  actionUrl     String?
  scholarshipId String?
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  scholarship Scholarship? @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------
//  خدمة صياغة السيرة الذاتية (خبير بشري + ذكاء اصطناعي)
// ------------------------------------------------------------

model ExpertProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  titlePrefix    String? // د. / أ.د
  specialization String?
  bio            String? @db.Text
  isAvailable    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expert_profiles")
}

model CvOrder {
  id          String        @id @default(cuid())
  orderNumber String        @unique
  userId      String
  expertId    String?
  status      CvOrderStatus @default(DRAFT)

  /// الخطوة الحالية في الويزرد (1..5)
  currentStep Int @default(1)

  /// نسخة من بيانات الويزرد وقت الإرسال
  dataSnapshot Json?

  /// معدل توافق الفرز الأكاديمي الآلي (ATS)
  atsScore Int?

  expectedDeliveryAt DateTime?
  submittedAt        DateTime?
  deliveredAt        DateTime?
  finalFileUrl       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation("OrderOwner", fields: [userId], references: [id], onDelete: Cascade)
  expert   User?         @relation("OrderExpert", fields: [expertId], references: [id], onDelete: SetNull)
  timeline CvOrderEvent[]
  notes    CvOrderNote[]
  atsChecks CvAtsCheck[]

  @@index([userId])
  @@index([status])
  @@map("cv_orders")
}

model CvOrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  title       String
  description String?        @db.Text
  status      TimelineStatus @default(PENDING)
  sortOrder   Int            @default(0)
  occurredAt  DateTime?

  order CvOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("cv_order_events")
}

model CvOrderNote {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  order  CvOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("cv_order_notes")
}

/// بنود تقرير التدقيق الأكاديمي الشامل
model CvAtsCheck {
  id        String  @id @default(cuid())
  orderId   String
  label     String  @db.Text
  passed    Boolean @default(true)
  sortOrder Int     @default(0)

  order CvOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("cv_ats_checks")
}

// ------------------------------------------------------------
//  أدوات الذكاء الاصطناعي
// ------------------------------------------------------------

model AiTool {
  id          String  @id @default(cuid())
  key         String  @unique
  nameAr      String
  description String?
  icon        String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs AiToolRun[]

  @@map("ai_tools")
}

model AiToolRun {
  id         String      @id @default(cuid())
  toolId     String
  userId     String?
  status     AiRunStatus @default(RUNNING)
  input      Json?
  output     String?     @db.Text
  errorMessage String?
  durationMs Int?
  createdAt  DateTime    @default(now())

  tool AiTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolId, createdAt])
  @@index([userId])
  @@index([status])
  @@map("ai_tool_runs")
}

// ------------------------------------------------------------
//  الإدارة
// ------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// رسائل "تواصل معنا"
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  body      String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contact_messages")
}
